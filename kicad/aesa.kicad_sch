	(lib_symbols)
	(text "Hybrid 8x8 ultrasonic AESA: how the signal flows"
		(exclude_from_sim no)
		(at 25.40 27.94 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a7841496-ca83-5fdf-a47a-7adb95add458")
	)
	(text "1. The FPGA streams one TX bit per element (16 serial lines, 10 MHz) and the clocks."
		(exclude_from_sim no)
		(at 25.40 35.56 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "40a3c3d5-c716-5d69-9cc1-4f3093d870cd")
	)
	(text "2. TX drive: shift registers latch the bits; gate drivers switch each element between 0 and 15 V."
		(exclude_from_sim no)
		(at 25.40 39.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "89f68389-2d68-5d89-a97d-c32205493788")
	)
	(text "3. Transceivers: the 64 CUSP-TR80 elements emit 40 kHz; echoes return to the same elements."
		(exclude_from_sim no)
		(at 25.40 44.20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "114c38a9-5abb-556f-bc4b-8e7ae1afd6a9")
	)
	(text "4. The diode T/R switch and limiter protect the receiver; amplifier + 40 kHz band-pass give x22."
		(exclude_from_sim no)
		(at 25.40 48.52 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2dcff14f-c2fe-5b34-ab7d-b3c3599f767c")
	)
	(text "5. ADCs: 16 x TLV320ADC5140 sample all 64 channels at once, 192 kSPS (raw waveform, amplitude and phase)."
		(exclude_from_sim no)
		(at 25.40 52.84 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "5c08c087-325b-5604-aba8-aba115e8bab7")
	)
	(text "6. The samples go back to the FPGA over the ribbon, which forms the beams. 8 MEMS mics add wideband audio."
		(exclude_from_sim no)
		(at 25.40 57.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "6afefa4b-a0e2-5d2c-a022-4bef7d22f952")
	)
