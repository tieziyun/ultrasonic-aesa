	(text "33 R source resistors on DOUTA/DOUTB/BUSY (ribbon to the FPGA); BUSY is used from ADC1 only."
		(exclude_from_sim no)
		(at 30.48 48.26 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7680bcfb-bc6d-528e-a1b3-a122115b9969")
	)
	(text "Software mode: OS0-OS2 high. FPGA writes registers over SDI (pin 29, DB11/SDI) at boot:"
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9538b1e2-96c0-5732-be6d-11fd2df43eab")
	)
	(text "DB9/DB10 are tied to GND: never set DOUT_FORMAT to 4 lines. After power-up the FPGA pulses ADC_RESET (full reset), then writes the registers."
		(exclude_from_sim no)
		(at 30.48 53.34 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "cc8324d5-34fa-5381-a773-c59fa48daa8c")
	)
	(text "RANGE_CHx = 0x1 (+-5 V), BANDWIDTH = 0xFF (high bandwidth on all 8 channels), CONFIG DOUT_FORMAT = 2 lines."
		(exclude_from_sim no)
		(at 30.48 38.1 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d2e255ca-ac58-5b74-bd0d-249943b0155a")
	)
