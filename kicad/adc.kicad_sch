	(text "Decoupling (place at the pins): four 100 nF on the AVCC pins + 10 uF bulk, 100 nF on VDRIVE; REGCAP 1 uF x2, REFCAP 10 uF, REFIN/OUT 100 nF per datasheet"
		(exclude_from_sim no)
		(at 30.48 205.74 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4c53b95d-3422-5ecc-b477-416840d18a23")
	)
	(text "33 R source resistors on DOUTA/DOUTB/BUSY (ribbon to the FPGA); BUSY is used from ADC1 only."
		(exclude_from_sim no)
		(at 30.48 48.26 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
