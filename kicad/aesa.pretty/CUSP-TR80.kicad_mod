(footprint "CUSP-TR80"
	(version 20241229)
	(generator "hand")
	(layer "F.Cu")
	(descr "Same Sky CUSP-TR80-15-2500-TH ultrasonic transceiver, Ø9.8 x 7 mm ABS case, 2 pins Ø0.7 mm at 5.0 mm pitch. Datasheet recommended layout: Ø2 mm pads, Ø0.9 mm holes. Pad 1 = '+' pin (signal), pad 2 = the other pin (GND).")
	(tags "ultrasonic transducer transceiver 40kHz CUSP-TR80")
	(property "Reference" "REF**"
		(at 0 -6.2 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "CUSP-TR80"
		(at 0 6.2 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Datasheet" "https://www.sameskydevices.com/product/resource/cusp-tr80-15-2500-th.pdf"
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole)
	(fp_circle (center 0 0) (end 4.9 0) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_circle (center 0 0) (end 5.05 0) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
	(fp_circle (center 0 0) (end 5.4 0) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_text user "+" (at -2.5 -1.8 0) (layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user "${REFERENCE}" (at 0 -3 0) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(pad "1" thru_hole rect (at -2.5 0) (size 2 2) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at 2.5 0) (size 2 2) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/aesa.3dshapes/CUSP-TR80.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
